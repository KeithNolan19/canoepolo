<%- include('partials/header', { metaDescription: 'Other canoe polo tournaments on today, with times, pitches and scores, from Kayakers.nl.' }) %>

<div class="page-banner">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / <a href="/tournaments">Tournaments</a> / Other tournaments today</p>
    <h1>Other tournaments today</h1>
  </div>
</div>

<div class="wrap oe">
  <p class="small-note">Times, pitches and scores come from <a href="https://cpt.kayakers.nl" target="_blank" rel="noopener">Kayakers.nl</a>, used with their permission. They refresh about every 3 minutes. Kayakers.nl and the tournament organiser are always right: please check their page for the official result.</p>
  <% if (!on) { %><p class="notice">This feature is switched off at the moment.</p><% } %>
  <% if (!events.length) { %><p>No games to show yet. Tournaments appear here while they are on.</p><% } %>
  <% events.forEach(function (e) { %>
    <section class="oe-event">
      <h2><%= e.name %></h2>
      <p class="small-note">Source: <a href="https://cpt.kayakers.nl/View/<%= encodeURIComponent(e.slug) %>" target="_blank" rel="noopener">Kayakers.nl</a></p>
      <% e.days.forEach(function (d) { %>
        <% if (d[0]) { %><h3 class="sub-head"><%= new Date(d[0] + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }) %></h3><% } %>
        <ul class="oe-games">
        <% d[1].forEach(function (g) { %>
          <li class="oe-game">
            <span class="oe-when"><%= g.time %><small>pitch <%= g.pitch %></small></span>
            <span class="oe-teams"><strong><%= g.team_a || 'To be decided' %></strong> <em>v</em> <strong><%= g.team_b || 'To be decided' %></strong><small><%= g.division %><%= g.grp ? ' · Group ' + g.grp : '' %></small></span>
            <span class="oe-score"><% if (g.score_a != null && g.score_b != null) { %><%= g.score_a %> - <%= g.score_b %><% } else { %>-<% } %><small><%= g.status === 100 ? 'Full time' : (g.status_text || '') %></small></span>
          </li>
        <% }) %>
        </ul>
      <% }) %>
    </section>
  <% }) %>
</div>

<%- include('partials/footer') %>
