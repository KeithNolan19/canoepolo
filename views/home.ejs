<%- include('partials/header', { fullWidth: true }) %>
<% const thumb = (id) => `https://i.ytimg.com/vi/${id}/mqdefault.jpg`; %>
<%
  // Hero pitch: boats start on their goal lines and paddle into an attacking set-up.
  // [fromX, fromY, fromAngle, toX, toY, toAngle]
  const red = [[1, 4, 0, 23.5, 12, 0], [1, 8, 0, 25, 4.8, 20], [1, 11.5, 0, 25, 18.8, -20], [1, 15, 0, 20, 8, 0], [1, 19, 0, 29, 13.4, 15]];
  const white = [[34, 4, 180, 34, 11.5, 180], [34, 8, 180, 31, 9, 200], [34, 11.5, 180, 30.9, 15.2, 150], [34, 15, 180, 28.5, 6.5, 200], [34, 19, 180, 28.5, 18.5, 160]];
  const boat = 'M-1.5 0C-1.3-.31-.9-.31-.5-.31H.5C.9-.31 1.3-.31 1.5 0 1.3.31.9.31.5.31H-.5C-.9.31-1.3.31-1.5 0Z';
%>

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1>The home of international canoe polo</h1>
      <p class="hero-sub">Tournaments, rules, refereeing, videos and a tactics board, for everyone in the canoe polo family: players, coaches, referees, volunteers, clubs and fans.</p>
      <p class="hero-actions">
        <a class="btn primary big" href="/tournaments">Find a tournament</a>
        <a class="btn ghost big" href="#fit">Where do I fit in?</a>
      </p>
      <% if (nextUp.length) { const n = nextUp[0]; %>
      <a class="hero-next" href="/tournaments/<%= n.slug %>">
        <span class="hero-next-label">Next tournament</span>
        <span class="hero-next-name"><%= n.name %></span>
        <span class="hero-next-meta"><%= fmtRange(n.start_date, n.end_date) %>, <%= flag(n.country) %> <%= n.city %></span>
      </a>
      <% } %>
    </div>
    <figure class="hero-pitch">
      <svg viewBox="-1.5 -1.5 38 26" role="img" aria-label="Top-down view of a canoe polo pitch with two teams of five kayaks setting up an attack">
        <rect x="-1.5" y="-1.5" width="38" height="26" rx="1.2" class="hp-deck"/>
        <rect x="0" y="0" width="35" height="23" class="hp-water"/>
        <g class="hp-lanes"><% for (let y = 2.875; y < 23; y += 2.875) { %><line x1="0" y1="<%= y %>" x2="35" y2="<%= y %>"/><% } %></g>
        <g class="hp-lines">
          <rect x="0" y="0" width="35" height="23"/>
          <line x1="17.5" y1="0" x2="17.5" y2="23"/>
          <line x1="6" y1="0" x2="6" y2="23" class="dash"/>
          <line x1="29" y1="0" x2="29" y2="23" class="dash"/>
        </g>
        <rect x="-0.5" y="10.75" width="0.5" height="1.5" class="hp-goal"/>
        <rect x="35" y="10.75" width="0.5" height="1.5" class="hp-goal"/>
        <path class="hp-pass" d="M24.6 11.6 Q27 12.2 28.6 13.2"/>
        <% red.forEach((b, i) => { %><g class="hp-boat red" data-from="<%= b.slice(0, 3).join(',') %>" data-to="<%= b.slice(3).join(',') %>" transform="translate(<%= b[3] %> <%= b[4] %>) rotate(<%= b[5] %>)"><path d="<%= boat %>"/><text y=".02" transform="rotate(<%= -b[5] %>)"><%= i + 1 %></text></g><% }) %>
        <% white.forEach((b, i) => { %><g class="hp-boat white" data-from="<%= b.slice(0, 3).join(',') %>" data-to="<%= b.slice(3).join(',') %>" transform="translate(<%= b[3] %> <%= b[4] %>) rotate(<%= b[5] %>)"><path d="<%= boat %>"/><text y=".02" transform="rotate(<%= -b[5] %>)"><%= i + 1 %></text></g><% }) %>
        <circle class="hp-ball" r=".36" cx="24.6" cy="11.6" data-from="17.5,11.5"/>
      </svg>
      <figcaption>A screen for a shot, drawn on our <a href="/tactics">tactics board</a>.</figcaption>
    </figure>
  </div>
</section>

<section class="fit" id="fit">
  <div class="wrap">
    <h2 class="section-title">Where do you fit in?</h2>
    <ul class="fit-list">
      <% FAMILY.forEach(f => { const [main, ...more] = f.links; %>
      <li>
        <a class="fit-main" href="<%= main[1] %>">
          <span class="fit-title"><%= f.title %></span>
          <span class="fit-text"><%= f.text %></span>
          <span class="fit-go"><%= main[0] %><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <% if (more.length) { %><p class="fit-more">Also: <% more.forEach(([label, href], n) => { %><%= n ? ', ' : '' %><a href="<%= href %>"><%= label %></a><% }) %></p><% } %>
      </li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="wrap home-split">
  <div>
    <div class="section-head">
      <h2 class="section-title">Upcoming tournaments</h2>
      <a class="text-link" href="/tournaments">See all tournaments</a>
    </div>
    <% if (nextUp.length) { %>
      <%- include('partials/fixtures', { rows: nextUp, monthHeaders: false }) %>
    <% } else { %>
      <p class="empty-note">No tournaments listed yet. <a href="/about#listing">Tell us about one</a> and we'll add it.</p>
    <% } %>
  </div>
  <aside class="home-aside">
    <div class="aside-card">
      <h2>Running a tournament?</h2>
      <p>Set it up for free on Kayakers.nl with registration, schedules and live results, then send us the link and we'll list it here.</p>
      <p class="aside-actions">
        <a class="btn primary" href="<%= CREATE_TOURNAMENT_URL %>" target="_blank" rel="noopener">Open Kayakers.nl</a>
        <a class="btn" href="/about#listing">List your tournament</a>
      </p>
    </div>
    <% if (countryCounts.length) { %>
    <div class="aside-block">
      <h2>By country</h2>
      <ul class="country-list">
        <% countryCounts.slice(0, 8).forEach(([code, n]) => { %>
        <li><a href="/tournaments?country=<%= code %>"><span><%= flag(code) %> <%= COUNTRIES[code] || code %></span><span class="num"><%= n %></span></a></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
    <div class="aside-block">
      <h2>Keep up to date</h2>
      <p>Add the calendar to Google, Apple or Outlook and new tournaments appear on their own.</p>
      <p><a class="btn" href="/calendar.ics">Subscribe to the calendar</a></p>
    </div>
  </aside>
</section>

<% if (videos.length) { %>
<section class="band band-deep">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title">Watch the best</h2>
      <a class="text-link" href="/watch">All videos</a>
    </div>
    <ul class="video-grid">
      <% videos.forEach(v => { %>
      <li class="video-card">
        <a class="video-thumb" href="/watch">
          <span class="video-frame"><img src="<%= thumb(v.youtube_id) %>" alt="" loading="lazy"><span class="play" aria-hidden="true"></span></span>
          <span class="video-title"><%= v.title %></span>
        </a>
        <% if (v.event) { %><p class="video-event"><%= v.event %></p><% } %>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>

<section class="wrap learn-row">
  <div class="section-head">
    <h2 class="section-title">Learn the game</h2>
    <a class="text-link" href="/learn">Everything to learn</a>
  </div>
  <ul class="learn-cards">
    <li><a href="/rules"><strong>The rules, simply explained</strong><span>The pitch, five seconds, tackles, the goalkeeper and cards.</span></a></li>
    <li><a href="/referee/quiz"><strong>Referee quiz</strong><span>Ten random questions on rules and hand signals. How many can you get?</span></a></li>
    <li><a href="/tactics"><strong>Tactics board</strong><span>Drag kayaks, draw passes and share plays with your team.</span></a></li>
  </ul>
</section>

<section class="wrap">
  <div class="contact-strip">
    <div>
      <h2>Built by the canoe polo family</h2>
      <p>News, results, a club looking for players, or an idea for the site? Tell us.</p>
    </div>
    <a class="btn primary big" href="mailto:info@canoepolo.eu?subject=canoepolo.eu">Email info@canoepolo.eu</a>
  </div>
</section>

<%- include('partials/footer') %>
