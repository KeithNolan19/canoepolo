<%- include('partials/header', { fullWidth: true, metaDescription: 'Canoe polo referee quiz: 10 random multiple-choice questions on the rules and referee hand signals, with your score at the end.' }) %>

<div class="page-banner">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / <a href="/learn">Learn</a> / <a href="/referee">Referee</a> / Quiz</p>
    <h1>Referee quiz</h1>
  </div>
</div>

<div class="wrap quiz-wrap">
<div class="quiz-layout">
  <div class="quiz-main">
  <div id="quiz" class="quiz" aria-live="polite">
    <div class="quiz-intro">
      <p class="intro-text">Ten multiple-choice questions on the rules and the referees' hand signals. You get a fresh random set every time, and your score at the end.</p>
      <ul class="quiz-facts">
        <li><strong>10</strong> questions</li>
        <li><strong>4</strong> hand-signal questions</li>
        <li><strong>1</strong> right answer each</li>
      </ul>
      <form id="quiz-form" class="quiz-join" autocomplete="off">
        <h2>Join the leaderboard (optional)</h2>
        <p class="small-note">Add your details to get your score on the <a href="/referee/leaderboard">leaderboard</a> when you finish. Or leave the box unticked and just play.</p>
        <label>Name <input type="text" id="qj-name" maxlength="40" placeholder="First and last name"></label>
        <label>Club <input type="text" id="qj-club" maxlength="50" placeholder="Club name, if any"></label>
        <label>Country
          <select id="qj-country"><option value="">Choose a country</option>
            <% Object.keys(COUNTRIES).sort(function (a, b) { return COUNTRIES[a].localeCompare(COUNTRIES[b]); }).forEach(function (c) { %><option value="<%= c %>"><%= COUNTRIES[c] %></option><% }) %>
          </select>
        </label>
        <label class="check"><input type="checkbox" id="qj-consent"> I'm happy for my name, club, country and score to be shown publicly on the leaderboard. I can ask to have it removed at any time.</label>
        <p id="qj-error" class="notice red" role="alert" hidden></p>
        <p><button type="submit" class="btn primary" id="quiz-start">Start the quiz</button></p>
      </form>
      <noscript><p class="notice red">The quiz needs JavaScript switched on.</p></noscript>
    </div>
  </div>
  </div>
  <aside class="lb-panel" aria-labelledby="lb-title">
    <h2 id="lb-title">🏆 Leaderboard</h2>
    <% if (!board.length) { %>
      <p class="small-note">No scores yet. Join the leaderboard and be the first on the board!</p>
    <% } else { %>
      <ol class="lb-list">
        <% board.forEach(function (r) { %>
        <li><span class="lb-who"><strong><%= r.name %></strong><small><%= flag(r.country) %> <%= r.club ? r.club + ', ' : '' %><%= COUNTRIES[r.country] || r.country %></small></span><span class="lb-score"><%= r.score %>/10</span></li>
        <% }) %>
      </ol>
    <% } %>
    <p><a class="btn small" href="/referee/leaderboard">Full leaderboard</a></p>
    <p class="small-note">Tick the box on the start screen to put your name on it.</p>
  </aside>
</div>
  <p class="small-note quiz-note">Questions are based on the ICF Canoe Polo Competition Rules. See the <a href="/referee/leaderboard">leaderboard</a>. Revise with <a href="/referee#rules">all the rules</a> and the <a href="/referee#signals">hand signals</a>.</p>
</div>

<script src="/signals.js?v=<%= assetV %>"></script>
<script src="/quiz.js?v=<%= assetV %>"></script>
<%- include('partials/footer') %>
