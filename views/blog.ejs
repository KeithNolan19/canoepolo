<%- include('partials/header', { fullWidth: true }) %>

<div class="page-banner">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / Blog</p>
    <h1>Canoe polo blog</h1>
  </div>
</div>

<div class="wrap narrow-page">
  <% if (!posts.length) { %>
    <div class="empty"><p>No posts yet. Check back soon.</p></div>
  <% } else { %>
    <ul class="post-list">
    <% posts.forEach(p => { %>
      <li>
        <h2><a href="/blog/<%= p.slug %>"><%= p.title %></a></h2>
        <p class="post-meta"><time datetime="<%= p.published_at %>"><%= fmtDate(p.published_at) %></time> &middot; <%= readMins(p.body) %> min read</p>
        <p><%= p.summary %></p>
      </li>
    <% }) %>
    </ul>
  <% } %>
  <p class="small-note"><a href="/blog/feed.xml">RSS feed</a></p>
</div>

<%- include('partials/footer') %>
