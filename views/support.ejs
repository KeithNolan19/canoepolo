<%- include('partials/header', { fullWidth: true }) %>

<div class="page-banner">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / <a href="/tournaments/<%= slug %>">ECC 2026</a> / Support your club</p>
    <h1>Support your club</h1>
  </div>
</div>

<div class="wrap narrow-page">
  <p class="lead">Pick your country to see its clubs at the European Club Championships in Milan: every game, live scores, scorers, referee and table duties and gazebo numbers.</p>
  <ul class="sup-grid">
    <% countries.forEach(c => { %>
    <li><a href="/tournaments/<%= slug %>/support/<%= c.cc %>"><span class="sup-flag" aria-hidden="true"><%- flagImg(c.cc) %></span><strong><%= c.name %></strong><span class="muted"><%= c.teams.length %> team<%= c.teams.length === 1 ? '' : 's' %></span></a></li>
    <% }) %>
  </ul>
  <p class="small-note">Scores and match details come directly from the ECC organiser.</p>
</div>

<%- include('partials/footer') %>
