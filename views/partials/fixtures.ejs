<%# Tournament list. Expects: rows (tournaments), monthHeaders (bool) %>
<% const mon = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }); %>
<ol class="events">
<% let lastMonth = ''; rows.forEach(t => {
     const m = t.start_date.slice(0, 7);
     if (monthHeaders && m !== lastMonth) { lastMonth = m; %>
  <li class="events-month"><h2><%= fmtDate(t.start_date, { month: 'long', year: 'numeric' }) %></h2></li>
<% }
     const d1 = Number(t.start_date.slice(8)), d2 = Number(t.end_date.slice(8));
     const sameMonth = t.start_date.slice(0, 7) === t.end_date.slice(0, 7);
     const days = t.start_date === t.end_date ? String(d1) : `${d1}–${d2}`; %>
  <li class="event <%= t.status === 'cancelled' ? 'is-cancelled' : '' %> <%= t.featured ? 'is-featured' : '' %>">
    <a href="/tournaments/<%= t.slug %>">
      <span class="event-date" aria-hidden="true">
        <span class="event-days"><%= days %></span>
        <span class="event-mon"><%= mon(t.start_date) %><%= sameMonth ? '' : '–' + mon(t.end_date) %></span>
      </span>
      <span class="event-body">
        <span class="event-name"><%= t.name %><% if (t.status === 'cancelled') { %> <span class="tag tag-red">Cancelled</span><% } %><% if (t.featured) { %> <span class="tag tag-ball">Featured</span><% } %></span>
        <span class="event-where"><%= flag(t.country) %> <%= t.city %>, <%= t.country_name %></span>
        <span class="event-extra"><span class="visually-hidden"><%= fmtRange(t.start_date, t.end_date) %>. </span><%= t.level %><% if (t.divisions.length) { %>: <%= t.divisions.join(', ') %><% } %></span>
      </span>
      <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </li>
<% }) %>
</ol>
