<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | canoepolo.eu</title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'The home of international canoe polo (kayak polo): tournaments, videos, rules, refereeing and ways to get involved, for players, coaches, referees, volunteers and clubs.' %>">
  <meta name="robots" content="noai, noimageai">
  <link rel="canonical" href="<%= canonical %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'The home of international canoe polo (kayak polo).' %>">
  <meta property="og:title" content="<%= title %> | canoepolo.eu">
  <meta property="og:site_name" content="canoepolo.eu">
  <meta name="theme-color" content="#0a3b36">
  <link rel="icon" href="/images/favicon-48.png?v=<%= assetV %>" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=<%= assetV %>">
  <meta property="og:image" content="<%= BASE_URL %>/images/icon-512.png">
  <link rel="preload" href="/fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetV %>">
  <link rel="alternate" type="application/rss+xml" title="canoepolo.eu blog" href="/blog/feed.xml">
  <link rel="alternate" type="text/calendar" title="Canoe polo tournaments" href="/calendar.ics">
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<% if (langs.length) { %>
<div class="langbar" data-base="<%= BASE_URL %>">
  <div class="wrap">
    <span class="lg-label">Translate with Google:</span>
    <ul class="lg-list"><% langs.forEach(l => { %><li><a href="<%= l.url %>" lang="<%= l.code %>" hreflang="<%= l.code %>" rel="nofollow noopener" target="_blank"><%= l.name %></a></li><% }) %></ul>
    <a class="lg-back" href="<%= BASE_URL %>" hidden>Back to English</a>
  </div>
</div>
<% } %>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="canoepolo.eu home">
      <picture>
        <source srcset="/images/logo-dark.png?v=<%= assetV %>" media="(prefers-color-scheme: dark)">
        <img class="brand-logo" src="/images/logo.png?v=<%= assetV %>" width="900" height="216" alt="canoepolo.eu">
      </picture>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span class="nav-toggle-bars" aria-hidden="true"></span>Menu</button>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <a href="/tournaments" class="<%= path.startsWith('/tournaments') || path === '/past' ? 'on' : '' %>">Tournaments</a>
      <a href="/watch" class="<%= path === '/watch' ? 'on' : '' %>">Watch</a>
      <a href="/learn" class="<%= ['/learn', '/rules', '/tactics'].includes(path) ? 'on' : '' %>">Learn</a>
      <a href="/blog" class="<%= path.startsWith('/blog') ? 'on' : '' %>">Blog</a>
      <a href="/referee" class="<%= path.startsWith('/referee') ? 'on' : '' %>">Referee</a>
      <a href="/get-involved" class="<%= path === '/get-involved' || path === '/support' ? 'on' : '' %>">Get involved</a>
      <a href="/shop" class="<%= path === '/shop' ? 'on' : '' %>">Shop</a>
      <a href="/about" class="<%= path === '/about' ? 'on' : '' %>">About</a>
      <% if (isAdmin) { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'on' : '' %>">Admin</a><% } %>
      <a class="nav-cta" href="/tournaments">Find a tournament</a>
    </nav>
  </div>
</header>
<main id="content" class="<%= typeof fullWidth !== 'undefined' && fullWidth ? 'full' : 'wrap' %>">
