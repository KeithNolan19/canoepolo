<%- include('partials/header', { fullWidth: true, metaDescription: 'Watch canoe polo: highlights, finals and full games from the World Championships, plus videos to learn the game. Streamed by Planet Canoe.' }) %>
<% const yt = (id) => `https://www.youtube.com/watch?v=${id}`; %>
<% const thumb = (id, q) => `/thumb/${id}/${q || 'hqdefault'}.jpg`; %>

<div class="page-banner">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / Watch</p>
    <h1>Watch canoe polo</h1>
  </div>
</div>

<% if (featured) { %>
<section class="watch-lead">
  <div class="wrap watch-lead-grid">
    <div class="video-frame big" data-video="<%= featured.youtube_id %>" data-title="<%= featured.title %>">
      <a class="video-facade" href="<%= yt(featured.youtube_id) %>" target="_blank" rel="noopener" aria-label="Play: <%= featured.title %>">
        <img src="<%= thumb(featured.youtube_id, 'hqdefault') %>" alt="" loading="eager">
        <span class="play" aria-hidden="true"></span>
      </a>
    </div>
    <div class="watch-lead-text">
      <p class="event-level"><%= CATEGORIES[featured.category] %></p>
      <h2><%= featured.title %></h2>
      <% if (featured.event) { %><p class="watch-event"><%= featured.event %></p><% } %>
      <p class="watch-intro">Never seen canoe polo? It's five-a-side water polo in kayaks: fast sprints, big hits and shots at a goal two metres above the water. Start with the highlights, then watch a final from start to finish.</p>
      <p class="lead-actions">
        <a class="btn primary" href="https://www.youtube.com/@PlanetCanoe/streams" target="_blank" rel="noopener">Live streams on Planet Canoe ↗</a>
        <a class="btn outline" href="/rules">How the game works</a>
      </p>
    </div>
  </div>
</section>
<% } %>

<div class="wrap">
  <% groups.forEach(g => { if (!g.videos.length) return; %>
  <section class="block watch-block" id="<%= g.key %>">
    <div class="block-head"><h2><%= g.label %></h2></div>
    <ul class="video-grid">
      <% g.videos.forEach(v => { %>
      <li class="video-card">
        <div class="video-frame" data-video="<%= v.youtube_id %>" data-title="<%= v.title %>">
          <a class="video-facade" href="<%= yt(v.youtube_id) %>" target="_blank" rel="noopener" aria-label="Play: <%= v.title %>">
            <img src="<%= thumb(v.youtube_id, 'mqdefault') %>" alt="" loading="lazy">
            <span class="play" aria-hidden="true"></span>
          </a>
        </div>
        <h3><%= v.title %></h3>
        <% if (v.event) { %><p class="video-event"><%= v.event %></p><% } %>
      </li>
      <% }) %>
    </ul>
  </section>
  <% }) %>

  <section class="block">
    <div class="block-head"><h2>Where to watch more</h2></div>
    <ul class="channel-list">
      <% CHANNELS.forEach(c => { %>
      <li><a href="<%= c.url %>" target="_blank" rel="noopener"><strong><%= c.name %> ↗</strong><span><%= c.text %></span></a></li>
      <% }) %>
    </ul>
    <p class="small-note">Videos play from YouTube. Nothing loads from YouTube until you press play; see our <a href="/privacy#videos">privacy policy</a>.</p>
  </section>

  <aside class="side-note support-cta">
    <h2>Got a great game on video?</h2>
    <p>Send us a YouTube link to a club final, a great goal or a coaching video and we'll add it here.</p>
    <p><a href="mailto:info@canoepolo.eu?subject=Video%20for%20canoepolo.eu">Suggest a video</a></p>
  </aside>
</div>

<%- include('partials/footer') %>
