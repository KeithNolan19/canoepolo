<%- include('../partials/header') %>

<%- include('tabs', { tab: 'stats' }) %>

<div class="admin-head">
  <h1>Statistics</h1>
  <nav class="admin-tabs range-tabs" aria-label="Time range">
    <% [7, 30, 90, 365].forEach(function (d) { %><a href="/admin/stats?days=<%= d %>" class="<%= d === days ? 'on' : '' %>"><%= d === 365 ? '1 year' : 'Last ' + d + ' days' %></a><% }) %>
  </nav>
</div>

<p class="small-note">Anonymous counts only: no cookies, no IP addresses saved. People using Do Not Track and known bots are not counted. Visitors are approximate (a person using two devices counts twice, and the count can restart if the server restarts).</p>

<div class="stat-cards">
  <div class="stat-card"><span class="stat-num"><%= r.views %></span><span>Page views</span></div>
  <div class="stat-card"><span class="stat-num"><%= r.visitors %></span><span>Visitors (approx.)</span></div>
  <div class="stat-card"><span class="stat-num"><%= r.visitStats.total %></span><span>Visits</span></div>
  <div class="stat-card"><span class="stat-num"><%= r.visitStats.bounceRate %>%</span><span>Left after one page</span></div>
  <div class="stat-card"><span class="stat-num"><%= r.visitStats.avgPages %></span><span>Pages per visit</span></div>
  <div class="stat-card"><span class="stat-num"><%= Math.floor(r.visitStats.avgSecs / 60) %>m <%= r.visitStats.avgSecs % 60 %>s</span><span>Visit length (2+ pages)</span></div>
  <div class="stat-card"><span class="stat-num"><%= r.downloadTotal %></span><span>Downloads</span></div>
</div>
<p class="small-note">A visit is one person browsing with no break longer than 30 minutes. Visits are counted when they end, so the last half hour can be missing. A visit that leaves after one page is a "bounce". Visit length only counts visits with 2 or more pages, because time on a single page can't be measured.</p>

<h2>Views per day</h2>
<table class="stat-table">
  <% r.series.slice().reverse().forEach(function (d) { %>
  <tr><td class="stat-day"><%= d.day %></td><td class="stat-bar"><progress max="<%= max %>" value="<%= d.views %>"></progress></td><td class="num"><%= d.views %></td><td class="num muted"><%= d.visitors %> visitors</td></tr>
  <% }) %>
</table>

<h2>Pages: views and drop-off</h2>
<p class="small-note">"Entered" is how many visits started on that page. "Left" is how many visits ended on it. "Drop-off" is left divided by views: the higher it is, the more often people stop there.</p>
<div class="table-wrap">
<table class="admin-table stat-flow">
  <thead><tr><th>Page</th><th class="num">Views</th><th class="num">Entered</th><th class="num">Left</th><th class="num">Drop-off</th></tr></thead>
  <tbody>
  <% r.pageFlow.forEach(function (p) { %><tr><td class="wrap-any"><a href="<%= p.path %>"><%= p.path %></a></td><td class="num"><%= p.views %></td><td class="num"><%= p.entries %></td><td class="num"><%= p.exits %></td><td class="num"><progress max="100" value="<%= p.exitRate %>"></progress> <%= p.exitRate %>%</td></tr><% }) %>
  <% if (!r.pageFlow.length) { %><tr><td class="muted" colspan="5">No data yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<div class="stat-cols">
  <div>
    <h2>Pages per visit</h2>
    <table class="stat-table">
      <% r.visitStats.buckets.forEach(function (b) { %><tr><td><%= b.bucket === '1' ? '1 page (left straight away)' : b.bucket + ' pages' %></td><td class="stat-bar"><progress max="<%= Math.max(1, r.visitStats.total) %>" value="<%= b.n %>"></progress></td><td class="num"><%= b.n %></td></tr><% }) %>
    </table>

    <h2>Downloads</h2>
    <table class="stat-table">
      <% r.downloadKinds.forEach(function (k) { %><tr><td><strong><%= k.kind %></strong></td><td class="num"><strong><%= k.n %></strong></td></tr><% }) %>
      <% r.downloads.forEach(function (d) { %><tr><td class="wrap-any muted"><%= d.kind %>: <%= d.name %></td><td class="num"><%= d.n %></td></tr><% }) %>
      <% if (!r.downloads.length) { %><tr><td class="muted">No downloads yet.</td></tr><% } %>
    </table>
    <p class="small-note">Counted when the file is sent: PDFs in the documents, team schedule PDFs and Excel files, and calendar files. People who have Do Not Track switched on are not counted.</p>

    <h2>Referee quiz: where people stop</h2>
    <table class="stat-table">
      <% r.funnel.forEach(function (f) { %><tr><td><%= f.label %></td><td class="stat-bar"><progress max="<%= Math.max(1, r.funnel[0].n) %>" value="<%= f.n %>"></progress></td><td class="num"><%= f.n %></td><td class="num muted"><%= r.funnel[0].n ? Math.round(f.n / r.funnel[0].n * 100) : 0 %>%</td></tr><% }) %>
    </table>
    <p class="small-note">How many times each question was shown, and how many quizzes were finished. Team schedules viewed: <%= r.schedTeam %>.</p>
  </div>
  <div>
    <h2>Visitors by country</h2>
    <table class="stat-table">
      <% r.countries.forEach(function (p) { %><tr><td><%- p.country === '??' ? 'Unknown' : flagImg(p.country) %> <%= p.country === '??' ? '' : (COUNTRIES[p.country] || regionName(p.country)) %></td><td class="num"><%= p.n %></td></tr><% }) %>
      <% if (!r.countries.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <p class="small-note">Country is worked out from the visitor's IP address at the moment of the visit; the address itself is not saved. IP location data by <a href="https://db-ip.com" target="_blank" rel="noopener">DB-IP.com</a>. It's approximate, and VPN users show as the VPN's country.</p>
    <h2>Where visitors come from</h2>
    <table class="stat-table">
      <% r.refs.forEach(function (p) { %><tr><td><%= p.ref %></td><td class="num"><%= p.n %></td></tr><% }) %>
      <% if (!r.refs.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h2>Links clicked (leaving the site, and downloads)</h2>
    <table class="stat-table">
      <% r.clicks.forEach(function (p) { %><tr><td class="wrap-any"><%= p.target %></td><td class="num"><%= p.n %></td></tr><% }) %>
      <% if (!r.clicks.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
  </div>
</div>

<%
  const tbl = (rows, key, empty) => rows.length ? rows : [];
  const maxOf = (rows, k) => Math.max(1, ...rows.map((x) => x[k || 'n']));
%>
<h2>Who is visiting: devices and browsers</h2>
<p class="small-note">Anonymous categories only, counted once per visitor per day. The raw browser details are never saved.</p>
<div class="stat-cols">
  <div>
    <h3>Device</h3>
    <table class="stat-table">
      <% r.dims.device.forEach(function (x) { %><tr><td><%= x.val %></td><td class="stat-bar"><progress max="<%= maxOf(r.dims.device) %>" value="<%= x.n %>"></progress></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.device.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Browser</h3>
    <table class="stat-table">
      <% r.dims.browser.forEach(function (x) { %><tr><td><%= x.val %></td><td class="stat-bar"><progress max="<%= maxOf(r.dims.browser) %>" value="<%= x.n %>"></progress></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.browser.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Operating system</h3>
    <table class="stat-table">
      <% r.dims.os.forEach(function (x) { %><tr><td><%= x.val %></td><td class="stat-bar"><progress max="<%= maxOf(r.dims.os) %>" value="<%= x.n %>"></progress></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.os.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Screen width (page loads)</h3>
    <table class="stat-table">
      <% r.events.viewports.forEach(function (x) { %><tr><td><%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.events.viewports.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
  </div>
  <div>
    <h3>Language setting</h3>
    <table class="stat-table">
      <% r.dims.lang.forEach(function (x) { %><tr><td><%= x.val %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.lang.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>How they found us</h3>
    <table class="stat-table">
      <% r.dims.source.forEach(function (x) { %><tr><td><%= x.val %></td><td class="stat-bar"><progress max="<%= maxOf(r.dims.source) %>" value="<%= x.n %>"></progress></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.source.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Campaign tags (utm links)</h3>
    <table class="stat-table">
      <% r.dims.campaign.forEach(function (x) { %><tr><td class="wrap-any"><%= x.val %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.campaign.length) { %><tr><td class="muted">None yet. Add ?utm_source=poster to a link to see where people came from.</td></tr><% } %>
    </table>
  </div>
</div>

<h2>When people visit (Milan time)</h2>
<table class="stat-table stat-hours">
  <% r.dims.hours.forEach(function (x) { %><tr><td class="stat-day"><%= x.val %>:00</td><td class="stat-bar"><progress max="<%= maxOf(r.dims.hours) %>" value="<%= x.n %>"></progress></td><td class="num"><%= x.n %></td></tr><% }) %>
</table>

<h2>ECC 2026</h2>
<div class="stat-cols">
  <div>
    <h3>ECC pages viewed</h3>
    <table class="stat-table">
      <% eccPages.forEach(function (x) { %><tr><td class="wrap-any"><a href="<%= x.path %>"><%= x.path.replace('/tournaments/paddle-europe-canoe-polo-club-championships-2026', 'ECC') %></a></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!eccPages.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Game pop-ups opened</h3>
    <table class="stat-table">
      <% r.events.gameOpens.forEach(function (x) { %><tr><td><%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.events.gameOpens.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Schedule filters used</h3>
    <table class="stat-table">
      <% r.events.filters.forEach(function (x) { %><tr><td><%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.events.filters.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
  </div>
  <div>
    <h3>Most looked-up teams</h3>
    <table class="stat-table">
      <% r.events.teams.forEach(function (x) { %><tr><td><%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.events.teams.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Text updates</h3>
    <table class="stat-table">
      <tr><td>Sign-up form started</td><td class="num"><%= r.events.smsStart %></td></tr>
      <tr><td>Team search used</td><td class="num"><%= r.events.smsSearch %></td></tr>
      <% if (smsAgg) { %>
      <tr><td>Confirmed numbers now</td><td class="num"><%= smsAgg.numbers %></td></tr>
      <tr><td>Stopped</td><td class="num"><%= smsAgg.stopped %></td></tr>
      <tr><td>Teams followed (total)</td><td class="num"><%= smsAgg.follows %></td></tr>
      <tr><td>Texts sent today</td><td class="num"><%= smsAgg.sentToday %></td></tr>
      <% smsAgg.perTeam.forEach(function (t) { %><tr><td class="muted">Following <%= t.team %> (<%= t.division %>)</td><td class="num"><%= t.n %></td></tr><% }) %>
      <% } else { %><tr><td class="muted">Text updates are not switched on.</td></tr><% } %>
    </table>
    <h3>Live score reader</h3>
    <table class="stat-table">
      <tr><td>Games read from the organiser</td><td class="num"><%= liveHealth.gamesRead %></td></tr>
      <tr><td>Games with a score</td><td class="num"><%= liveHealth.withScores %></td></tr>
      <tr><td>Finished games</td><td class="num"><%= liveHealth.finished %></td></tr>
      <tr><td>Last read</td><td class="num"><%= liveHealth.lastReadAt ? new Date(liveHealth.lastReadAt).toLocaleTimeString('en-GB', { timeZone: 'Europe/Rome' }) + ' (Milan)' : 'not yet' %></td></tr>
      <tr><td>Paused because their site failed</td><td class="num"><%= liveHealth.paused ? 'YES, back at ' + new Date(liveHealth.pausedUntil).toLocaleTimeString('en-GB', { timeZone: 'Europe/Rome' }) : 'no' %></td></tr>
    </table>
  </div>
</div>

<h2>Tactics board use</h2>
<div class="stat-cols">
  <div>
    <h3>Actions</h3>
    <table class="stat-table">
      <% r.events.tx.forEach(function (x) { %><tr><td><%= {play:'Play pressed',share:'Share link copied',png:'Image downloaded',undo:'Undo',flip:'Swap ends',addstep:'Step added'}[x.label] %></td><td class="num"><%= x.n %></td></tr><% }) %>
    </table>
  </div>
  <div>
    <h3>Presets, defences and attacks picked</h3>
    <table class="stat-table">
      <% r.events.txPresets.forEach(function (x) { %><tr><td>Preset: <%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% r.events.txDef.forEach(function (x) { %><tr><td>Defence: <%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% r.events.txAtk.forEach(function (x) { %><tr><td>Attack: <%= x.label %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.events.txPresets.length && !r.events.txDef.length && !r.events.txAtk.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
  </div>
</div>

<h2>Site health</h2>
<div class="stat-cols">
  <div>
    <h3>Slowest pages (average ms to build)</h3>
    <table class="stat-table">
      <% r.perf.forEach(function (x) { %><tr><td class="wrap-any"><%= x.path %></td><td class="num"><%= x.avg %> ms</td><td class="num muted">max <%= x.max %></td></tr><% }) %>
      <% if (!r.perf.length) { %><tr><td class="muted">No data yet.</td></tr><% } %>
    </table>
    <h3>Broken links (page not found)</h3>
    <table class="stat-table">
      <% r.dims.notfound.forEach(function (x) { %><tr><td class="wrap-any"><%= x.val %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.notfound.length) { %><tr><td class="muted">None.</td></tr><% } %>
    </table>
  </div>
  <div>
    <h3>Server errors</h3>
    <table class="stat-table">
      <% r.dims.error.forEach(function (x) { %><tr><td class="wrap-any"><%= x.val %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.error.length) { %><tr><td class="muted">None.</td></tr><% } %>
    </table>
    <h3>Copying tools turned away</h3>
    <table class="stat-table">
      <% r.dims.blocked.forEach(function (x) { %><tr><td><%= x.val %></td><td class="num"><%= x.n %></td></tr><% }) %>
      <% if (!r.dims.blocked.length) { %><tr><td class="muted">None yet.</td></tr><% } %>
    </table>
    <p class="small-note">Build time is how long our server took, not how long a page takes on a phone.</p>
  </div>
</div>

<%- include('../partials/footer') %>
