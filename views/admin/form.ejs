<%- include('../partials/header') %>
<% const v = (k) => (t[k] == null ? '' : t[k]);
  let docs = t.documents; if (typeof docs === 'string') { try { docs = JSON.parse(docs); } catch { docs = []; } }
  const docsText = (docs || []).map((d) => d.label + ' | ' + d.url).join('\n');
  let tms = t.teams; if (typeof tms === 'string') { try { tms = JSON.parse(tms); } catch { tms = []; } }
  const teamsText = (tms || []).map((x) => x.country ? x.name + ' | ' + x.country : x.name).join('\n'); %>

<p class="back"><a href="/admin">← Back to admin</a></p>
<form class="panel" method="post" action="<%= action %>">
  <h1><%= title %></h1>

  <% if (errors.length) { %>
    <div class="notice red"><strong>Please fix:</strong><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>

  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <fieldset>
    <legend>Basics</legend>
    <label class="full">Tournament name * <input name="name" value="<%= v('name') %>" maxlength="150" required></label>
    <label>Start date * <input type="date" name="start_date" value="<%= v('start_date') %>" required></label>
    <label>End date <input type="date" name="end_date" value="<%= v('end_date') %>"></label>
    <label>Level
      <select name="level"><% LEVELS.forEach(l => { %><option <%= v('level') === l ? 'selected' : '' %>><%= l %></option><% }) %></select>
    </label>
    <label>Status
      <select name="status">
        <option value="published" <%= v('status') === 'published' ? 'selected' : '' %>>Published (visible)</option>
        <option value="draft" <%= v('status') === 'draft' ? 'selected' : '' %>>Draft (hidden)</option>
        <option value="cancelled" <%= v('status') === 'cancelled' ? 'selected' : '' %>>Cancelled (shown as cancelled)</option>
      </select>
    </label>
    <label class="check full"><input type="checkbox" name="featured" value="1" <%= t.featured ? 'checked' : '' %>> Featured (pinned to top of the list)</label>
  </fieldset>

  <fieldset>
    <legend>Location</legend>
    <label>City * <input name="city" value="<%= v('city') %>" required></label>
    <label>Country *
      <select name="country" required>
        <option value="">Choose…</option>
        <% Object.entries(COUNTRIES).sort((a,b) => a[1].localeCompare(b[1])).forEach(([code, name]) => { %>
          <option value="<%= code %>" <%= v('country') === code ? 'selected' : '' %>><%= name %></option>
        <% }) %>
      </select>
    </label>
    <label class="full">Venue <input name="venue" value="<%= v('venue') %>" placeholder="e.g. National Watersports Centre"></label>
    <label>Map latitude (optional) <input name="lat" inputmode="decimal" value="<%= v('lat') %>" placeholder="e.g. 38.52"></label>
    <label>Map longitude (optional) <input name="lng" inputmode="decimal" value="<%= v('lng') %>" placeholder="e.g. -8.89"></label>
    <p class="small-note full">Leave both empty and the map pin goes on the town if we know it, otherwise the middle of the country. To place it exactly, right click the venue in an online map and copy the two numbers.</p>
  </fieldset>

  <fieldset>
    <legend>Divisions</legend>
    <div class="checks full">
      <% DIVISIONS.forEach(d => { %>
        <label class="check"><input type="checkbox" name="divisions" value="<%= d %>" <%= (t.divisions || []).includes(d) ? 'checked' : '' %>> <%= d %></label>
      <% }) %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Registration &amp; links</legend>
    <label class="full">Official website <input type="url" name="website_url" value="<%= v('website_url') %>" placeholder="https://"></label>
    <label class="full">Registration link <input type="url" name="registration_url" value="<%= v('registration_url') %>" placeholder="https://"></label>
    <label class="full">Source (the page where these details were announced) <input type="url" name="source_url" value="<%= v('source_url') %>" placeholder="https://"></label>
    <label>Registration deadline <input type="date" name="registration_deadline" value="<%= v('registration_deadline') %>"></label>
    <label>Entry fee <input name="entry_fee" value="<%= v('entry_fee') %>" placeholder="e.g. €250 per team"></label>
    <label>Contact name <input name="contact_name" value="<%= v('contact_name') %>"></label>
    <label>Contact email <input type="email" name="contact_email" value="<%= v('contact_email') %>"></label>
  </fieldset>

  <fieldset>
    <legend>Documents</legend>
    <label class="full">Bulletins, timetables and other files, one per line as <code>Label | link</code>
      <textarea name="documents_text" rows="4" placeholder="Bulletin 1 | https://...&#10;Timetable | https://..."><%= docsText %></textarea>
    </label>
  </fieldset>

  <fieldset>
    <legend>Teams entered</legend>
    <label class="full">One team per line as <code>Team name | PT</code> (two letter country code). Use <code>To be confirmed</code> for an open place.
      <textarea name="teams_text" rows="6" placeholder="Setúbal | PT&#10;Deventer | NL&#10;To be confirmed"><%= teamsText %></textarea>
    </label>
  </fieldset>

  <fieldset>
    <legend>Description</legend>
    <label class="full">Details for players (leave a blank line between paragraphs)
      <textarea name="description" rows="8"><%= v('description') %></textarea>
    </label>
  </fieldset>

  <div class="actions">
    <button class="btn primary" type="submit">Save tournament</button>
    <a class="btn" href="/admin">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
