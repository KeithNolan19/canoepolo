<%- include('../partials/header') %>

<%- include('tabs', { tab: 'sms' }) %>

<div class="admin-head"><h1>Text updates</h1></div>
<% if (msg) { %><p class="notice green"><%= msg %></p><% } %>
<p>Status: <strong><%= s.open ? (s.dryRun ? 'Test mode (nothing is sent)' : 'Live') : 'Off' %></strong> &middot; confirmed numbers <strong><%= s.numbers %> of <%= s.maxSignups %></strong> &middot; follows <strong><%= s.follows %></strong> &middot; stopped <strong><%= s.stopped %></strong> &middot; texts today <strong><%= s.sentToday %></strong> of <%= s.cap %></p>

<form method="post" action="/admin/sms/send" class="quiz-join sms-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Send a message now</h2>
  <label>To
    <select name="team">
      <option value="">Everyone signed up (<%= s.numbers %>)</option>
      <% teams.forEach(t => { const k = t.name + '|' + t.division; %><option value="<%= k %>"><%= t.name %> (<%= t.division %>)<%= counts[k] ? ' - ' + counts[k] + ' followers' : '' %></option><% }) %>
    </select>
  </label>
  <label>Message (up to 120 characters; the Stop link is added)
    <input type="text" name="text" maxlength="120" required>
  </label>
  <label class="sms-consent"><input type="checkbox" name="confirm" value="1"> I checked the message. It is about the games or the tournament, not advertising.</label>
  <p><button class="btn primary" type="submit">Send</button></p>
</form>
<p class="small-note">People agreed to texts about their teams at the ECC. Keep messages to that: delays, pitch changes, schedule notices.</p>

<h2>All sign-ups (<%= s.signups.length %>)</h2>
<div class="table-wrap"><table class="lb-table">
  <thead><tr><th>Number</th><th>Teams</th><th>Signed up</th><th>Status</th><th>Texts</th></tr></thead>
  <tbody>
  <% s.signups.forEach(r => { %><tr><td><%= r.phone %></td><td><%= r.teams || '-' %></td><td><%= fmt(r.created) %></td><td><%= r.stopped ? 'Stopped' : (r.verified ? 'Confirmed' : 'Code not entered') %></td><td><%= r.texts %></td></tr><% }) %>
  <% if (!s.signups.length) { %><tr><td colspan="5">No sign-ups yet.</td></tr><% } %>
  </tbody>
</table></div>

<h2>Texts sent (latest 300)</h2>
<div class="table-wrap"><table class="lb-table">
  <thead><tr><th>When</th><th>To</th><th>Message</th><th>Result</th></tr></thead>
  <tbody>
  <% s.log.forEach(r => { %><tr><td><%= fmt(r.at) %></td><td><%= r.phone %></td><td><%= r.body %></td><td><%= r.status %></td></tr><% }) %>
  <% if (!s.log.length) { %><tr><td colspan="4">Nothing sent yet.</td></tr><% } %>
  </tbody>
</table></div>

<% if (s.perTeam.length) { %><h2>Most followed</h2><ul><% s.perTeam.forEach(r => { %><li><%= r.team %> (<%= r.division %>): <%= r.n %></li><% }) %></ul><% } %>

<%- include('../partials/footer') %>
