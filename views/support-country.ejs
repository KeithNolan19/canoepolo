<%- include('partials/header', { fullWidth: true }) %>

<div class="page-banner">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / <a href="/tournaments/<%= slug %>">ECC 2026</a> / <a href="/tournaments/<%= slug %>/support">Support your club</a> / <%= country.name %></p>
    <h1><span class="tflag" aria-hidden="true"><%- flagImg(country.cc) %></span> <%= country.name %> at the ECC 2026</h1>
  </div>
</div>

<div class="wrap narrow-page">
  <div class="notice" role="note"><strong>Note:</strong> <%= sch.notice %></div>
  <p class="lead">Every game for the clubs from <%= country.name %> in Milan, with results, scorers, and referee and table duties.</p>
  <p class="ie-links">
    <a class="btn small primary" href="/tournaments/<%= slug %>/support">All countries</a>
    <a class="btn small" href="/tournaments/<%= slug %>">Full timetable</a>
    <a class="btn small" href="/tournaments/<%= slug %>/gazebos">Gazebos and site map</a>
    <a class="btn small" href="/docs/milan-ecc-2026-friday-officials.pdf" target="_blank" rel="noopener">Friday referees (PDF)</a>
  </p>

  <% teams.forEach(t => { %>
  <section class="ie-team">
    <h2><span class="tflag" aria-hidden="true"><%- flagImg(country.cc) %></span> <%= t.name %><% if (teams.filter(x => x.name === t.name).length > 1) { %> <small>(<%= t.division %>)</small><% } %></h2>
    <% { %>
    <p class="ie-sub"><%= t.division %> &middot; Group <%= t.group %><% if (t.gazebo) { %> &middot; Gazebo and boat storage <%= t.gazebo %><% } %></p>
    <% if (smsOpen) { %><p class="sms-cta"><a class="btn small primary" href="/tournaments/<%= slug %>/text-updates?team=<%= encodeURIComponent(t.name + '|' + t.division) %>">Text me when <%= t.name %> play</a></p><% } %>
    <p class="ie-stats">Played <strong><%= t.p %></strong> &middot; Won <strong><%= t.w %></strong> &middot; Drawn <strong><%= t.d %></strong> &middot; Lost <strong><%= t.l %></strong> &middot; Goals <strong><%= t.gf %> - <%= t.ga %></strong></p>
    <details class="gt" open><summary>Group <%= t.group %> table</summary><div data-standings="<%= t.division %>|<%= t.group %>" data-team="<%= t.name %>"></div></details>
    <div class="ie-scorers" data-scorers="<%= t.name %>|<%= t.division %>" hidden><h3 class="ie-duty-h">Scorers and cards so far</h3><ul></ul></div>
    <ul class="sched-matches ie-games">
      <% t.games.forEach(g => { %>
      <li class="sched-match <%= t.division === 'Women' ? 'is-women' : 'is-men' %>" data-code="<%= g.code %>" data-home="<%= g.away ? g.opp : t.name %>" data-away="<%= g.away ? t.name : g.opp %>" data-time="<%= g.start %>" data-pitch="<%= g.pitch %>" data-group="<%= g.group %>" data-live="<%= g.live %>" tabindex="0" role="button">
        <span class="sm-pitch"><%= g.day.split(' ')[0].slice(0, 3) %><br><%= g.start %></span>
        <span class="sm-teams">v <strong><% if (g.oppFlag) { %><span class="tflag" aria-hidden="true"><%- flagImg(g.oppFlag) %></span> <% } %><%= g.opp %></strong></span>
        <% if (g.live || g.hasScore) { %><span class="sm-score" data-score="<%= g.code %>" data-start="<%= g.start %>" data-flip="<%= g.away ? 1 : 0 %>" aria-live="polite"></span><% } %>
        <% if (g.live) { %><span class="sm-goals" data-goals="<%= g.code %>" data-side="<%= g.away ? 2 : 1 %>" data-team="<%= t.name %>" data-key="<%= t.name %>|<%= t.division %>" data-opp="<%= g.opp %>"></span><% } %>
        <span class="sm-meta">Pitch <%= g.pitch %> &middot; <%= g.stage %> &middot; <%= g.code %><% if (g.live) { %> &middot; <a class="sm-live" href="<%= g.live %>" target="_blank" rel="noopener">Live score</a><% } %></span>
      </li>
      <% }) %>
    </ul>
    <p class="small-note">Play-off games are added here as soon as the organiser names your club in them. Nothing is guessed.</p>
    <% } %>
  </section>
  <% }) %>

  <% const dn = Object.keys(duties).sort(); if (dn.length) { %>
  <section class="ie-team">
    <h2>Referee and table duties</h2>
    <% dn.forEach(n => { %>
    <h3 class="ie-duty-h"><%= n %></h3>
    <ul class="ie-duties"><% duties[n].forEach(d => { %><li><strong><%= d.day %> <%= d.start %></strong> &middot; <%= d.role %> &middot; <%= d.match %> (pitch <%= d.pitch %>, <%= d.code %>)</li><% }) %></ul>
    <% }) %>
  </section>
  <% } %>

  <p class="small-note">Scores and match details come directly from the ECC organiser. The played, won and goals figures count finished games only.</p>
</div>

<script src="/schedule.js?v=<%= assetV %>"></script>
<%- include('partials/footer') %>
