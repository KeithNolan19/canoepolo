# Copy this file to .env and fill it in (the setup script does this for you).
# NEVER share or upload your real .env file.

# Your domain, without https://
DOMAIN=canoepolo.eu

# Admin login for https://canoepolo.eu/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password-here

# Random secret used to sign login cookies (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Text (SMS) updates through Twilio. Leave these out and the feature stays switched off.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+353...            (your Twilio number, or a sender name if Twilio allows one for your countries)
# TWILIO_MESSAGING_SERVICE_SID=  (use instead of TWILIO_FROM if you made a Messaging Service)
# SMS_DAILY_CAP=150             (most texts sent in a day, codes included)
# SMS_MAX_SIGNUPS=10             (most confirmed numbers allowed)
# SMS_DRY_RUN=1                  (test: write texts to the server log instead of sending them)

# Optional settings (sensible defaults exist)
# PORT=3000                      (port the app listens on)
# BASE_URL=https://canoepolo.eu  (public address, used in links and the sitemap)
# DATA_DIR=./data                (where the database and backups live)
# LIVE_SCORES=off                (switch off the ECC live score reader, handy for testing)
